# 报销记录系统（单文件打包版） - 环境变量配置示例
# 使用方式：复制本文件为同目录下的 .env 并修改对应的值，程序启动时会自动读取
# 说明：单文件程序会优先读取「可执行文件所在目录」下的 .env

# ========== 数据库配置 ==========
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=reimburse_system

# ========== 服务配置 ==========
# 程序监听端口，浏览器访问 http://localhost:8080
SERVER_PORT=8080

# ========== Gin 模式 ==========
# development: 开发模式（默认，输出详细日志）
# release: 生产模式（推荐用于打包部署）
# test: 测试模式
GIN_MODE=release
