# 报销记录系统 - 环境变量配置示例
# 复制此文件为 .env 并修改对应的值

# ========== 数据库配置 ==========
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=reimburse_system

# ========== 服务配置 ==========
SERVER_PORT=8080

# ========== Gin 模式 ==========
# development: 开发模式（默认，输出详细日志）
# release: 生产模式
# test: 测试模式
GIN_MODE=development
